{
  "manifestVersion": 2,
  "id": "anilist",
  "name": "AniList and MyAnimeList",
  "version": "1.0.1",
  "apiVersion": "^1.0",
  "author": { "name": "Valence", "url": "https://github.com/ValenceOSS" },
  "description": "Imports what you have watched from AniList or MyAnimeList, marks those episodes watched in Valence, and keeps your list up to date as you watch.",
  "homepage": "https://github.com/ValenceOSS/valence-plugins/tree/main/plugins/anilist",
  "permissions": [
    {
      "kind": "network",
      "hosts": ["graphql.anilist.co", "anilist.co", "myanimelist.net", "api.myanimelist.net"]
    },
    {
      "kind": "accounts",
      "providers": [
        {
          "id": "anilist",
          "name": "AniList",
          "authorizeUrl": "https://anilist.co/api/v2/oauth/authorize",
          "tokenUrl": "https://anilist.co/api/v2/oauth/token",
          "scopes": [],
          "clientIdSetting": "anilistClientId",
          "clientSecretSetting": "anilistClientSecret"
        },
        {
          "id": "mal",
          "name": "MyAnimeList",
          "authorizeUrl": "https://myanimelist.net/v1/oauth2/authorize",
          "tokenUrl": "https://myanimelist.net/v1/oauth2/token",
          "scopes": [],
          "clientIdSetting": "malClientId",
          "clientSecretSetting": "malClientSecret"
        }
      ]
    },
    { "kind": "library", "access": "read" },
    { "kind": "viewing", "access": "write" },
    { "kind": "storage", "quotaBytes": 20000000 },
    { "kind": "notifications" }
  ],
  "contributes": {
    "pages": [
      { "id": "tracking", "title": "Anime tracking", "placement": "account", "icon": "tv" }
    ],
    "panels": [{ "id": "anime", "title": "Anime list", "on": "series" }],
    "schedules": [{ "id": "sync", "label": "Sync anime lists", "everyMinutes": 60 }],
    "events": ["playback.finished"]
  },
  "entry": "dist/plugin.js",
  "settings": [
    {
      "id": "anilistClientId",
      "label": "AniList client id",
      "kind": "text",
      "help": "Create an API client at anilist.co/settings/developer with Valence's redirect address.",
      "link": {
        "label": "AniList developer settings",
        "url": "https://anilist.co/settings/developer"
      }
    },
    { "id": "anilistClientSecret", "label": "AniList client secret", "kind": "secret" },
    {
      "id": "malClientId",
      "label": "MyAnimeList client id",
      "kind": "text",
      "help": "Create an API client at myanimelist.net/apiconfig with Valence's redirect address.",
      "link": { "label": "MyAnimeList API config", "url": "https://myanimelist.net/apiconfig" }
    },
    { "id": "malClientSecret", "label": "MyAnimeList client secret", "kind": "secret" }
  ]
}
